# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "An ergonomic RabbitMQ / AMQP messaging library for OCaml"
description:
  "Typed connections and channels, a router-style consumer, retries and dead-lettering, and self-healing reconnection - a friendly layer over amqp-client-lwt. The OCaml sibling of the Gleam and Dart `wren` libraries."
maintainer: ["cargopete"]
authors: ["cargopete"]
license: "MIT"
homepage: "https://github.com/cargopete/wren-ocaml"
bug-reports: "https://github.com/cargopete/wren-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.0"}
  "lwt" {>= "5.6.0"}
  "lwt_ppx"
  "amqp-client-lwt"
  "yojson"
  "logs"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cargopete/wren-ocaml.git"
